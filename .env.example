# Vector DB (Qdrant)
# Leave QDRANT_URL empty to run Qdrant embedded, stored on disk at QDRANT_PATH.
# Embedded mode allows one process at a time: stop the app before running ingest.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
# Multilingual embedding model (English, Gujarati, Urdu, Hindi), run locally by fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM (OpenAI)
OPENAI_API_KEY=
# Defaults to gpt-5.4-mini
OPENAI_MODEL=
# Optional, for reasoning models: low | medium | high (lower is faster for voice)
OPENAI_REASONING_EFFORT=

# LiveAvatar (talking avatar)
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_LANGUAGE=en
# true = free test sessions (~1 minute, only the sandbox avatar dd73ea75-1218-4ef3-92ce-606d5f7fbc0a)
LIVEAVATAR_SANDBOX=false
# Optional limit per session in seconds; empty = the plan maximum (FULL mode costs 2 credits a minute)
LIVEAVATAR_MAX_SECONDS=

# Sign-in
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
USE_MOCK_LOGIN=true
ADMIN_IDS=DEMO-ADMIN-001
SECRET_KEY=change-me
